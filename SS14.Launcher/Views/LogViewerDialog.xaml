<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
        xmlns:loc="clr-namespace:SS14.Launcher.Localization"
        mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="600"
        MinWidth="700" MinHeight="500"
        Width="850" Height="600"
        x:Class="SS14.Launcher.Views.LogViewerDialog"
        x:DataType="vm:LogViewerViewModel"
        Icon="/Assets/icon.ico"
        Title="{loc:Loc log-viewer-title}"
        Padding="12"
        Background="{DynamicResource ThemePopupBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:LogViewerViewModel />
  </Design.DataContext>
  <Window.DataContext>
    <vm:LogViewerViewModel />
  </Window.DataContext>

  <DockPanel>
    <!-- TOP TOOLBAR -->
    <Border DockPanel.Dock="Top" Classes="Card" Margin="0, 0, 0, 8" Padding="10">
      <StackPanel Spacing="8">
        <!-- Row 1: File selector + Action buttons -->
        <Grid ColumnDefinitions="Auto, *, Auto, Auto">
          <TextBlock Grid.Column="0" Text="{loc:Loc log-viewer-file}" VerticalAlignment="Center" Margin="0, 0, 10, 0"
                     Foreground="{DynamicResource ThemeSubTextBrush}" />
          <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableFiles}"
                    SelectedItem="{Binding SelectedLogFile}" VerticalAlignment="Center" Margin="0, 0, 8, 0"
                    HorizontalAlignment="Stretch" />

          <Button Grid.Column="2" Content="{loc:Loc log-viewer-refresh}" Command="{Binding RefreshFiles}"
                  VerticalAlignment="Center" Margin="0, 0, 8, 0" />

          <Button Grid.Column="3" Content="{loc:Loc log-viewer-open-folder}" Command="{Binding OpenLogsDirectory}"
                  VerticalAlignment="Center" />
        </Grid>

        <!-- Row 2: Search & Level Filter Chips -->
        <Grid ColumnDefinitions="*, Auto">
          <TextBox Grid.Column="0" Text="{Binding SearchFilter}"
                   Watermark="{loc:Loc log-viewer-search-watermark}"
                   VerticalAlignment="Center" Margin="0, 0, 10, 0" />

          <WrapPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="{loc:Loc log-viewer-filter-all}" Command="{Binding SetFilterAll}"
                    Classes.OpenBoth="{Binding IsFilterAll}" Margin="0, 0, 4, 0" />
            <Button Content="{loc:Loc log-viewer-filter-errors}" Command="{Binding SetFilterErrors}"
                    Foreground="#FF6B6B" Margin="0, 0, 4, 0" />
            <Button Content="{loc:Loc log-viewer-filter-warnings}" Command="{Binding SetFilterWarnings}"
                    Foreground="#F1C40F" Margin="0, 0, 4, 0" />
            <Button Content="{loc:Loc log-viewer-filter-info}" Command="{Binding SetFilterInfo}"
                    Foreground="#E0E6ED" Margin="0, 0, 4, 0" />
            <Button Content="{loc:Loc log-viewer-filter-debug}" Command="{Binding SetFilterDebug}"
                    Foreground="#7F8C8D" />
          </WrapPanel>
        </Grid>
      </StackPanel>
    </Border>

    <!-- BOTTOM ACTION BAR -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0, 8, 0, 0" LastChildFill="False">
      <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" VerticalAlignment="Center"
                 Foreground="{DynamicResource ThemeSubTextBrush}" FontSize="12" />

      <Button DockPanel.Dock="Right" Click="CloseClicked" Content="{loc:Loc log-viewer-close}" Classes="OpenLeft" />
      <Button DockPanel.Dock="Right" Content="{Binding CopyButtonText}" Command="{Binding CopyLogToClipboard}"
              Classes="OpenRight" Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
    </DockPanel>

    <!-- LOG VIEWER CONTENT AREA -->
    <Border Background="#121318" BorderBrush="#2F3545" BorderThickness="1" CornerRadius="6" Padding="6">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FilteredLines}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:LogLineItem">
              <SelectableTextBlock Text="{Binding Text}" Foreground="{Binding Color}"
                                   FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace"
                                   FontSize="12" Margin="2, 1" TextWrapping="NoWrap" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
  </DockPanel>
</Window>
