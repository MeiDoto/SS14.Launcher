<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="150"
             x:Class="SS14.Launcher.Views.LauncherUpdateProgressOverlayView"
             HorizontalAlignment="Center" VerticalAlignment="Center">

  <Design.DataContext>
    <vm:LauncherUpdateProgressOverlayViewModel />
  </Design.DataContext>

  <StackPanel Orientation="Vertical" Width="360" Margin="16" Spacing="6">
    <TextBlock HorizontalAlignment="Center" Classes="NanoHeadingMedium" Text="{Binding TitleText}" />

    <TextBlock HorizontalAlignment="Center" Margin="0, 6" Text="{Binding StatusText}"
               TextWrapping="Wrap" MaxWidth="340" TextAlignment="Center" />

    <ProgressBar Maximum="1" Value="{Binding Progress}"
                 IsIndeterminate="{Binding ProgressIndeterminate}"
                 IsVisible="{Binding !IsErrored}"
                 MinWidth="320" Height="14" />

    <DockPanel LastChildFill="False" Margin="0, 4, 0, 0">
      <Button DockPanel.Dock="Left"
              Content="{loc:Loc connecting-cancel}"
              Command="{Binding Cancel}"
              IsVisible="{Binding !IsErrored}" />

      <Button DockPanel.Dock="Left"
              Content="OK"
              Command="{Binding DismissError}"
              IsVisible="{Binding IsErrored}"
              HorizontalAlignment="Center" />

      <TextBlock DockPanel.Dock="Right" Margin="8, 4, 0, 4" Text="{Binding ProgressText}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding !ProgressIndeterminate}" />

      <TextBlock DockPanel.Dock="Right" Margin="0, 4" Text="{Binding SpeedText}"
                 TextWrapping="Wrap"
                 IsVisible="{Binding !ProgressIndeterminate}" />
    </DockPanel>
  </StackPanel>
</UserControl>
