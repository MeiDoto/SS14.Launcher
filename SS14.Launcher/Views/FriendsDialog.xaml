<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
        xmlns:loc="clr-namespace:SS14.Launcher.Localization"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="520"
        Width="700" Height="520"
        MinWidth="550" MinHeight="420"
        x:Class="SS14.Launcher.Views.FriendsDialog"
        x:DataType="vm:FriendsViewModel"
        Icon="/Assets/icon.ico"
        Title="{loc:Loc friends-dialog-title}"
        Padding="14"
        Background="{DynamicResource ThemePopupBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True">
    <!-- BOTTOM ACTION BAR -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0, 10, 0, 0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Click="CloseClicked" Content="{loc:Loc friends-close}" Classes="OpenLeft" />
    </DockPanel>

    <!-- TOP: ADD FRIEND CARD -->
    <Border DockPanel.Dock="Top" Classes="Card" Padding="12" Margin="0, 0, 0, 8">
      <StackPanel Spacing="8">
        <TextBlock Text="{loc:Loc friends-add-title}" Classes="NanoHeadingSmall" />
        <Grid ColumnDefinitions="*, *, *, Auto">
          <TextBox Grid.Column="0" Text="{Binding NewUsername}"
                   Watermark="{loc:Loc friends-username-watermark}"
                   Margin="0, 0, 6, 0" />
          <TextBox Grid.Column="1" Text="{Binding NewNote}"
                   Watermark="{loc:Loc friends-note-watermark}"
                   Margin="0, 0, 6, 0" />
          <TextBox Grid.Column="2" Text="{Binding NewServerAddress}"
                   Watermark="{loc:Loc friends-server-watermark}"
                   Margin="0, 0, 6, 0" />
          <Button Grid.Column="3" Content="{loc:Loc friends-add-button}"
                  Command="{Binding AddFriend}"
                  IsEnabled="{Binding CanAdd}"
                  Foreground="{DynamicResource ThemeNanoGoldBrush}"
                  FontWeight="SemiBold" />
        </Grid>
      </StackPanel>
    </Border>

    <!-- SEARCH FILTER BAR -->
    <Border DockPanel.Dock="Top" Classes="Card" Padding="8" Margin="0, 0, 0, 8">
      <TextBox Text="{Binding SearchFilter}"
               Watermark="{loc:Loc friends-search-watermark}"
               VerticalAlignment="Center" />
    </Border>

    <!-- CONTENT AREA (FILLS REMAINING SPACE) -->
    <Panel>
      <!-- EMPTY STATE -->
      <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
        <TextBlock Text="{loc:Loc friends-empty}" Classes="SubText" FontSize="14" HorizontalAlignment="Center" />
      </StackPanel>

      <!-- FRIENDS LIST -->
      <ScrollViewer IsVisible="{Binding HasFriends}" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding FilteredFriends}">
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="vm:FriendItemViewModel">
              <Border Classes="Card" Margin="0, 0, 0, 6" Padding="10">
                <Grid ColumnDefinitions="*, Auto">
                  <!-- LEFT: FRIEND INFO -->
                  <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13" />
                      <TextBlock Text="{Binding Note, StringFormat='({0})'}"
                                 Foreground="{DynamicResource ThemeNanoGoldBrush}"
                                 FontSize="12"
                                 IsVisible="{Binding HasNote}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusText}" Classes="SubText" FontSize="11" Margin="0, 2, 0, 0"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <!-- RIGHT: ACTIONS -->
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Content="{loc:Loc friends-connect}" Command="{Binding Connect}"
                            IsVisible="{Binding HasServer}"
                            Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
                    <Button Content="✕" Command="{Binding Delete}" ToolTip.Tip="{loc:Loc friends-remove-tooltip}" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</Window>
