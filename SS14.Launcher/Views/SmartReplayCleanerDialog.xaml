<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
        xmlns:loc="clr-namespace:SS14.Launcher.Localization"
        mc:Ignorable="d" d:DesignWidth="580" d:DesignHeight="520"
        Width="580" Height="520"
        CanResize="False"
        x:Class="SS14.Launcher.Views.SmartReplayCleanerDialog"
        x:DataType="vm:SmartReplayCleanerViewModel"
        Icon="/Assets/icon.ico"
        Title="{loc:Loc replay-cleaner-title}"
        Padding="16"
        Background="{DynamicResource ThemePopupBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True">
    <!-- BOTTOM ACTIONS -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0, 14, 0, 0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Classes="OpenLeft" Click="CancelClicked" Content="{loc:Loc replay-cleaner-cancel-button}" />
      <Button DockPanel.Dock="Right" Classes="OpenRight" Click="ExecuteCleanClicked" Content="{loc:Loc replay-cleaner-execute-button}"
              IsEnabled="{Binding CanClean}" />
    </DockPanel>

    <StackPanel Spacing="12">
      <!-- HEADER -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Loc replay-cleaner-title}" Classes="NanoHeadingMedium" />
          <TextBlock Text="{loc:Loc replay-cleaner-desc}" Classes="SubText" TextWrapping="Wrap" Margin="0, 4, 0, 0" />
        </StackPanel>
      </Border>

      <!-- SETTINGS CARD -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="12">
          <!-- Age Filter -->
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc replay-cleaner-filter-age}" FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding AgeOptions}" SelectedIndex="{Binding SelectedAgeIndex}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <!-- Quota Filter -->
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:Loc replay-cleaner-quota}" FontWeight="SemiBold" FontSize="13" />
            <ComboBox ItemsSource="{Binding QuotaOptions}" SelectedIndex="{Binding SelectedQuotaIndex}" HorizontalAlignment="Stretch" />
          </StackPanel>

          <!-- Checkboxes -->
          <CheckBox IsChecked="{Binding DeleteCorrupted}" Content="{loc:Loc replay-cleaner-delete-corrupted}" Margin="0, 4, 0, 0" />
          <CheckBox IsChecked="{Binding ExcludeFavorites}" Content="{loc:Loc replay-cleaner-exclude-favorites}" />
        </StackPanel>
      </Border>

      <!-- PREVIEW CARD -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="6">
          <TextBlock Text="{loc:Loc replay-cleaner-preview-header}" Classes="SectionTitle" />
          <Grid ColumnDefinitions="*, *" Margin="0, 4, 0, 0">
            <!-- Count -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeServerListBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeControlMidBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10, 8" Margin="0, 0, 4, 0">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Loc replay-cleaner-preview-count-label}" Classes="SubText" FontSize="11" />
                <TextBlock Text="{Binding CandidatesCount}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThemeForegroundColor}" />
              </StackPanel>
            </Border>
            <!-- Space freed -->
            <Border Grid.Column="1" Background="{DynamicResource ThemeServerListBackgroundBrush}"
                    BorderBrush="{DynamicResource ThemeControlMidBrush}" BorderThickness="1"
                    CornerRadius="4" Padding="10, 8" Margin="4, 0, 0, 0">
              <StackPanel Spacing="2">
                <TextBlock Text="{loc:Loc replay-cleaner-preview-freed-label}" Classes="SubText" FontSize="11" />
                <TextBlock Text="{Binding FreedBytesFormatted}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThemeNanoGoldBrush}" />
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
