<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:views="clr-namespace:SS14.Launcher.Views"
             mc:Ignorable="d" d:DesignWidth="880" d:DesignHeight="600"
             x:Class="SS14.Launcher.Views.MainWindowTabs.ReplaysTabView"
             x:DataType="mainWindowTabs:ReplaysTabViewModel">
  <Design.DataContext>
    <mainWindowTabs:ReplaysTabViewModel />
  </Design.DataContext>

  <DockPanel LastChildFill="True">
    <!-- TOP HEADER -->
    <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="4, 0, 4, 2">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
        <TextBlock Text="{loc:Loc tab-replays-title}" Classes="NanoHeadingMedium" VerticalAlignment="Center" />
        <!-- Subtle inline statistics -->
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="4, 2, 0, 0">
          <TextBlock Text="{Binding TotalCount, StringFormat='({0})'}" Classes="SubText" FontSize="13" VerticalAlignment="Center" />
          <TextBlock Text="•" Classes="SubText" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="{Binding TotalSizeFormatted}" Foreground="{DynamicResource ThemeNanoGoldBrush}" FontSize="12" VerticalAlignment="Center" />
          <TextBlock Text="•" Classes="SubText" FontSize="12" VerticalAlignment="Center"
                     IsVisible="{Binding FavoritesCount}" />
          <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center"
                      IsVisible="{Binding FavoritesCount}">
            <views:IconLabel Icon="{DynamicResource ButtonIcon-star}" Height="13" Width="13" VerticalAlignment="Center" />
            <TextBlock Text="{Binding FavoritesCount}" Classes="SubText" FontSize="12" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </StackPanel>

      <!-- Action Buttons Group (Right side of Header) -->
      <!-- Refresh Button with crisp vector icon -->
      <Button DockPanel.Dock="Right" Classes="OpenLeft" Command="{Binding RefreshReplays}"
              VerticalAlignment="Center" ToolTip.Tip="{loc:Loc tab-replays-refresh-tooltip}">
        <views:IconLabel Icon="{DynamicResource ButtonIcon-refresh}" Height="20" Width="20" />
      </Button>

      <!-- Batch Mode Toggle -->
      <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding IsBatchMode}"
                    Content="{loc:Loc tab-replays-batch-button}"
                    Classes="OpenBoth" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Loc tab-replays-batch-tooltip}" />

      <!-- Smart Cleaner -->
      <Button DockPanel.Dock="Right" Content="{loc:Loc tab-replays-cleaner-button}"
              Command="{Binding OpenSmartCleaner}"
              Classes="OpenBoth" VerticalAlignment="Center"
              ToolTip.Tip="{loc:Loc tab-replays-cleaner-tooltip}" />

      <!-- Open Folder -->
      <Button DockPanel.Dock="Right" Content="{loc:Loc tab-replays-open-folder}"
              Command="{Binding OpenReplaysFolder}"
              Classes="OpenBoth" VerticalAlignment="Center" />

      <!-- Open File -->
      <Button DockPanel.Dock="Right" Content="{loc:Loc tab-replays-browse-zip}"
              Command="{Binding OpenFilePickerAndPlay}"
              Classes="OpenRight" VerticalAlignment="Center" />
    </DockPanel>

    <Panel DockPanel.Dock="Top" Classes="ScrollViewerSep" />

    <!-- FILTER & SEARCH BAR -->
    <DockPanel DockPanel.Dock="Top" Margin="4, 4, 4, 4" Height="32">
      <!-- Sort Dropdown (Right) -->
      <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSortIndex}"
                VerticalAlignment="Center" MinWidth="150" Margin="4, 0, 0, 0" />

      <!-- Server Filter (Right) -->
      <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding AvailableServers}" SelectedItem="{Binding SelectedServer}"
                VerticalAlignment="Center" MinWidth="120" MaxWidth="160" Margin="4, 0, 0, 0" />

      <!-- Gamemode Filter (Right) -->
      <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding AvailableGamemodes}" SelectedItem="{Binding SelectedGamemode}"
                VerticalAlignment="Center" MinWidth="110" MaxWidth="140" Margin="4, 0, 0, 0" />

      <!-- Favorites Filter Toggle (Right) -->
      <ToggleButton DockPanel.Dock="Right" IsChecked="{Binding OnlyFavorites}"
                    Content="{loc:Loc tab-replays-filter-favorites}"
                    VerticalAlignment="Center" Margin="4, 0, 0, 0" />

      <!-- Search Box (Fills remaining width on Left) -->
      <TextBox Text="{Binding SearchString}"
               Watermark="{loc:Loc tab-replays-search-watermark}"
               UseFloatingWatermark="False"
               VerticalAlignment="Center" Margin="0, 0, 4, 0" />
    </DockPanel>

    <Panel DockPanel.Dock="Top" Classes="ScrollViewerSep" />

    <!-- BATCH ACTION BAR (Visible in Batch Mode) -->
    <DockPanel DockPanel.Dock="Top" Margin="4, 2, 4, 2" Height="32" IsVisible="{Binding IsBatchMode}">
      <Button DockPanel.Dock="Left" Classes="OpenRight" Content="{loc:Loc tab-replays-batch-select-all}" Command="{Binding SelectAll}" />
      <Button DockPanel.Dock="Left" Classes="OpenBoth" Content="{loc:Loc tab-replays-batch-deselect-all}" Command="{Binding DeselectAll}" />
      <Button DockPanel.Dock="Left" Classes="OpenLeft" Content="{Binding DeleteSelectedButtonText}" Command="{Binding DeleteSelected}"
              IsEnabled="{Binding HasSelectedItems}" />
      <Button DockPanel.Dock="Right" Content="{loc:Loc tab-replays-batch-cancel}" Command="{Binding ToggleBatchMode}" />
    </DockPanel>
    <Panel DockPanel.Dock="Top" Classes="ScrollViewerSep" IsVisible="{Binding IsBatchMode}" />

    <!-- Status Message Footer -->
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusMessage}"
               Classes="SubText" FontSize="11" Margin="6, 4, 6, 2" />
    <Panel DockPanel.Dock="Bottom" Classes="ScrollViewerSep" />

    <!-- MAIN REPLAYS LIST / EMPTY STATE -->
    <Panel Background="{DynamicResource ThemeServerListBackgroundBrush}">
      <!-- Empty State -->
      <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                  IsVisible="{Binding !FilteredReplays.Count}" Spacing="10">
        <TextBlock Text="{loc:Loc tab-replays-empty-title}" Classes="NanoHeadingMedium" HorizontalAlignment="Center" />
        <TextBlock Text="{loc:Loc tab-replays-empty-desc}"
                   Classes="SubText" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center" />
        <StackPanel Orientation="Horizontal" Spacing="0" HorizontalAlignment="Center" Margin="0, 8, 0, 0">
          <Button Classes="OpenRight" Content="{loc:Loc tab-replays-select-file}" Command="{Binding OpenFilePickerAndPlay}" />
          <Button Classes="OpenLeft" Content="{loc:Loc tab-replays-open-folder}" Command="{Binding OpenReplaysFolder}" />
        </StackPanel>
      </StackPanel>

      <!-- Virtualized List of Items -->
      <ListBox ItemsSource="{Binding FilteredReplays}"
               IsVisible="{Binding FilteredReplays.Count}"
               Background="Transparent" BorderThickness="0" Padding="0">
        <ListBox.Styles>
          <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
          </Style>
          <Style Selector="ListBoxItem:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource ThemeServerListRowAltBrush}" />
          </Style>
          <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ThemeTabItemSelectedBrush}" />
          </Style>
        </ListBox.Styles>
        <ListBox.ItemTemplate>
          <DataTemplate DataType="mainWindowTabs:ReplayItemViewModel">
            <Border BorderBrush="{DynamicResource ThemeListSeparatorColorTransparent}" BorderThickness="0,0,0,1"
                    Padding="10, 8">
              <DockPanel LastChildFill="True">
                <!-- Action Buttons Group (Right) -->
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center" Margin="8, 0, 0, 0">
                  <!-- Share feedback message if any -->
                  <TextBlock Text="{Binding ShareFeedback}" VerticalAlignment="Center"
                             Foreground="{DynamicResource ThemeNanoGoldBrush}" FontSize="11" Margin="0, 0, 8, 0" />

                  <!-- Play Watch Button (Angled left) -->
                  <Button Classes="OpenRight" Content="{loc:Loc tab-replays-play}" Command="{Binding Play}"
                          Padding="12, 4" VerticalAlignment="Center" />

                  <!-- Favorite Button (Native vector star) -->
                  <Button Classes="OpenBoth FavoriteButton" Classes.IsFavorite="{Binding IsFavorite}"
                          Command="{Binding ToggleFavorite}"
                          Padding="6, 4" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Loc tab-replays-card-fav-tooltip}">
                    <views:IconLabel Height="18" Width="18" />
                  </Button>

                  <!-- Copy Summary Button -->
                  <Button Classes="OpenBoth" Content="{loc:Loc tab-replays-card-copy}"
                          Command="{Binding CopyShareInfo}"
                          Padding="8, 4" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Loc tab-replays-card-share-tooltip}" />

                  <!-- Containing Folder Button -->
                  <Button Classes="OpenBoth" Content="{loc:Loc tab-replays-card-folder}"
                          Command="{Binding OpenContainingFolder}"
                          Padding="8, 4" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Loc tab-replays-card-folder-tooltip}" />

                  <!-- Details Inspector Button -->
                  <Button Classes="OpenBoth" Content="{loc:Loc tab-replays-card-details}"
                          Command="{Binding ShowDetails}"
                          Padding="8, 4" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Loc tab-replays-details-tooltip}" />

                  <!-- Delete Button (Angled right) -->
                  <Button Classes="OpenLeft" Content="{loc:Loc tab-replays-card-delete}"
                          Command="{Binding Delete}"
                          Padding="8, 4" VerticalAlignment="Center"
                          ToolTip.Tip="{loc:Loc tab-replays-delete-tooltip}" />
                </StackPanel>

                <!-- Checkbox for Batch Mode (Left) -->
                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsSelected}"
                          IsVisible="{Binding $parent[UserControl].((mainWindowTabs:ReplaysTabViewModel)DataContext).IsBatchMode}"
                          VerticalAlignment="Center" Margin="0, 0, 8, 0" />

                <!-- Main Item Info -->
                <StackPanel VerticalAlignment="Center" Spacing="3">
                  <!-- Row 1: Title and Badges -->
                  <DockPanel LastChildFill="True">
                    <!-- Badges Right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4" Margin="6, 0, 0, 0">
                      <!-- Round ID Badge -->
                      <Border IsVisible="{Binding RoundId, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="3" Padding="5, 1">
                        <TextBlock Text="{Binding RoundId, StringFormat='#{0}'}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForegroundColor}" />
                      </Border>

                      <!-- Gamemode Badge -->
                      <Border IsVisible="{Binding Gamemode, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="3" Padding="5, 1">
                        <TextBlock Text="{Binding Gamemode}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeForegroundColor}" />
                      </Border>

                      <!-- Map Badge -->
                      <Border IsVisible="{Binding MapName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                              Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="3" Padding="5, 1">
                        <TextBlock Text="{Binding MapName}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource ThemeSubTextBrush}" />
                      </Border>
                    </StackPanel>

                    <!-- Title -->
                    <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13"
                               TextTrimming="CharacterEllipsis" />
                  </DockPanel>

                  <!-- Row 2: Metadata (Clean typography without emojis) -->
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding DateFormatted}" Classes="SubText" FontSize="11" />
                    <TextBlock Text="•" Classes="SubText" FontSize="11" />
                    <TextBlock Text="{Binding FileSizeFormatted}" Foreground="{DynamicResource ThemeNanoGoldBrush}"
                               FontWeight="SemiBold" FontSize="11" />
                    <TextBlock Text="•" Classes="SubText" FontSize="11"
                               IsVisible="{Binding DurationInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding DurationInfo}" Classes="SubText" FontSize="11"
                               IsVisible="{Binding DurationInfo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="•" Classes="SubText" FontSize="11"
                               IsVisible="{Binding ServerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Text="{Binding ServerName}" Classes="SubText" FontSize="11"
                               IsVisible="{Binding ServerName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               TextTrimming="CharacterEllipsis" MaxWidth="260" />
                  </StackPanel>

                  <!-- Row 3: Note (if present) -->
                  <TextBlock Text="{Binding Note}"
                             IsVisible="{Binding HasNote}"
                             FontStyle="Italic" FontSize="11"
                             Foreground="{DynamicResource ThemeNanoGoldBrush}"
                             TextTrimming="CharacterEllipsis" MaxWidth="500" />
                </StackPanel>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>
  </DockPanel>
</UserControl>
