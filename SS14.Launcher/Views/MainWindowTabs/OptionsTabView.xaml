<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:mainWindowTabs="clr-namespace:SS14.Launcher.ViewModels.MainWindowTabs"
             xmlns:loc="clr-namespace:SS14.Launcher.Localization"
             xmlns:views="clr-namespace:SS14.Launcher.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SS14.Launcher.Views.MainWindowTabs.OptionsTabView"
             Name="NewsTab">
  <Design.DataContext>
    <mainWindowTabs:OptionsTabViewModel />
  </Design.DataContext>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <DockPanel Margin="16, 12">
      <Button Content="{loc:Loc tab-options-flip}" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Click="Flip" />

      <StackPanel Orientation="Vertical" Spacing="8">
        <!-- CARD 1: ABOUT LAUNCHER -->
        <Border Classes="Card">
          <StackPanel Orientation="Vertical" Spacing="6">
            <TextBlock Text="{loc:Loc tab-options-section-about}" Classes="SectionTitle" />

            <DockPanel Margin="4, 2">
              <TextBlock Text="{loc:Loc tab-options-launcher-version}" Classes="SubText" VerticalAlignment="Center" />
              <TextBlock Text="{Binding LauncherVersionDisplay}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                         Foreground="{DynamicResource ThemeNanoGoldBrush}" />
            </DockPanel>

            <TextBlock Text="{Binding UpdateStatusText}" TextWrapping="Wrap" Margin="4, 0"
                       IsVisible="{Binding UpdateStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <WrapPanel Orientation="Horizontal" Margin="4, 4, 0, 4">
              <Button Content="{loc:Loc tab-options-check-updates}" Click="CheckForUpdatesPressed"
                      IsEnabled="{Binding !IsCheckingUpdate}" Margin="0, 0, 6, 6" />
              <Button Content="{loc:Loc tab-options-update-now-button}" Click="ApplyUpdatePressed"
                      IsVisible="{Binding HasAvailableUpdate}"
                      Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="Bold" Margin="0, 0, 6, 6" />
              <Button Content="{loc:Loc tab-options-create-desktop-shortcut}" Click="CreateDesktopShortcutPressed"
                      IsVisible="{Binding IsDesktopShortcutSupported}" Margin="0, 0, 6, 6" />
            </WrapPanel>
          </StackPanel>
        </Border>

        <!-- CARD 2: APPEARANCE & CUSTOMIZATION -->
        <Border Classes="Card">
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Text="{loc:Loc tab-options-section-appearance}" Classes="SectionTitle" />

            <Button Click="OpenLauncherCustomizer" Content="{loc:Loc tab-options-launcher-customizer}" Margin="4" HorizontalAlignment="Left" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-launcher-customizer-desc}"
                       Margin="8, 0, 8, 8" />

            <views:LanguageSelector HorizontalAlignment="Left" Margin="4" DataContext="{Binding Language}"
                                    Placement="BottomEdgeAlignedLeft" />
          </StackPanel>
        </Border>

        <!-- CARD 2: NETWORK & PROXY -->
        <Border Classes="Card">
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Text="{loc:Loc tab-options-section-network}" Classes="SectionTitle" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding DnsOverHttps}" Content="{loc:Loc tab-options-doh}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-doh-desc}"
                       Margin="8, 0, 8, 8" />

            <Button Click="OpenProxySettings" Content="{loc:Loc tab-options-proxy-button}" Margin="4" HorizontalAlignment="Left"
                    Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-proxy-settings-desc}"
                       Margin="8, 0, 8, 8" />
          </StackPanel>
        </Border>

        <!-- CARD 3: PERFORMANCE & ACCOUNTS -->
        <Border Classes="Card">
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Text="{loc:Loc tab-options-section-performance}" Classes="SectionTitle" />

            <Button Content="{loc:Loc tab-options-account-settings}" Margin="4" Click="OpenAccountInfo" HorizontalAlignment="Left" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-account-settings-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding MultiAccounts}" Content="{loc:Loc tab-options-multi-accounts}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-multi-accounts-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding EnableTieredPGO}" Content="{loc:Loc tab-options-pgo-optimizations}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-pgo-optimizations-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding ForceServerGC}" Content="{loc:Loc tab-options-server-gc}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-server-gc-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding EnableFastPing}" Content="{loc:Loc tab-options-fast-ping}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-fast-ping-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding HighProcessPriority}" Content="{loc:Loc tab-options-process-priority}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-process-priority-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding ForceDedicatedGpu}" Content="{loc:Loc tab-options-dedicated-gpu}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-dedicated-gpu-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding MaxPerformanceJit}" Content="{loc:Loc tab-options-max-jit}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-max-jit-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding LowLatencyNetworking}" Content="{loc:Loc tab-options-low-latency-net}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-low-latency-net-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding DisableDiagnosticsOverhead}" Content="{loc:Loc tab-options-disable-diagnostics}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-disable-diagnostics-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding LowPauseGc}" Content="{loc:Loc tab-options-low-pause-gc}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-low-pause-gc-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding SmartCacheCleaner}" Content="{loc:Loc tab-options-smart-cache-cleaner}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-smart-cache-cleaner-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding FastLaunchPreload}" Content="{loc:Loc tab-options-fast-launch}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-fast-launch-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" IsVisible="{Binding !DisableIncompatibleMacOS}"
                      Margin="4" IsChecked="{Binding CompatMode}" Content="{loc:Loc tab-options-compatibility-mode}" />
            <CheckBox VerticalAlignment="Center" IsVisible="{Binding DisableIncompatibleMacOS}"
                      Margin="4" IsChecked="False" IsEnabled="False" Opacity="0.8" Content="{loc:Loc tab-options-compatibility-mode}" />
            <TextBlock VerticalAlignment="Center" IsVisible="{Binding !DisableIncompatibleMacOS}" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-compatibility-mode-desc}"
                       Margin="8, 0, 8, 4" />
            <TextBlock VerticalAlignment="Center" IsVisible="{Binding DisableIncompatibleMacOS}" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-desc-incompatible}"
                       Margin="8, 0, 8, 4" />
          </StackPanel>
        </Border>

        <!-- CARD 4: SYSTEM, HUBS & DATA -->
        <Border Classes="Card">
          <StackPanel Orientation="Vertical" Spacing="4">
            <TextBlock Text="{loc:Loc tab-options-section-system}" Classes="SectionTitle" />

            <WrapPanel Orientation="Horizontal" Margin="4, 0, 0, 4">
              <Button Click="OpenLogViewer" Content="{loc:Loc tab-options-log-viewer}" Margin="0, 0, 6, 6"
                      Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
              <Button Click="OpenLocalBuilds" Content="{loc:Loc tab-options-local-builds}" Margin="0, 0, 6, 6"
                      Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
              <Button Click="OpenHubSettings" Content="{loc:Loc tab-options-hub-settings}" Margin="0, 0, 6, 6" />
            </WrapPanel>

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding LogLauncherVerbose}" Content="{loc:Loc tab-options-verbose-launcher-logging}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-verbose-launcher-logging-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding TrackPlaytime}" Content="{loc:Loc tab-options-track-playtime}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-track-playtime-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding EnableSlotNotifier}" Content="{loc:Loc tab-options-enable-slot-notifier}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-enable-slot-notifier-desc}"
                       Margin="8, 0, 8, 4" />
            <Button Content="{loc:Loc tab-options-test-notification}" Click="TestNotificationPressed" IsVisible="{Binding EnableSlotNotifier}" Margin="8, 0, 0, 8" HorizontalAlignment="Left" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding ShowNewsTab}" Content="{loc:Loc tab-options-show-news-tab}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-show-news-tab-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding ShowReplaysTab}" Content="{loc:Loc tab-options-show-replays-tab}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-show-replays-tab-desc}"
                       Margin="8, 0, 8, 8" />

            <CheckBox VerticalAlignment="Center" Margin="4" IsChecked="{Binding ShowDevelopmentTab}" Content="{loc:Loc tab-options-show-dev-tab}" />
            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="{loc:Loc tab-options-show-dev-tab-desc}"
                       Margin="8, 0, 8, 8" />

            <WrapPanel Orientation="Horizontal" Margin="4, 4, 0, 4">
              <Button Content="{loc:Loc tab-options-open-user-data}" Command="{Binding OpenUserDataDirectory}" Margin="0, 0, 6, 6" />
              <Button Content="{loc:Loc tab-options-open-log-directory}" Command="{Binding OpenLogDirectory}" Margin="0, 0, 6, 6" />
              <Button Name="VerifyDatabaseButton" Content="{loc:Loc tab-options-verify-db}" Click="VerifyDatabasePressed" Margin="0, 0, 6, 6" />
              <Button Name="SmartCleanButton" Content="{loc:Loc tab-options-smart-clean}" Click="SmartCleanPressed" Margin="0, 0, 6, 6" />
              <Button Name="ClearServerContentButton" Content="{loc:Loc tab-options-clear-content}" Click="ClearServerContentPressed" Margin="0, 0, 6, 6" />
              <Button Name="ClearEnginesButton" Content="{loc:Loc tab-options-clear-engines}" Click="ClearEnginesPressed" Margin="0, 0, 6, 6" />
            </WrapPanel>
            <TextBlock Text="{Binding StorageUsageText}" Foreground="{DynamicResource ThemeNanoGoldBrush}" Margin="6, 4, 6, 2" FontSize="11" IsVisible="{Binding StorageUsageText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </DockPanel>
  </ScrollViewer>
</UserControl>
