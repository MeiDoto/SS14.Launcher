<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
        xmlns:loc="clr-namespace:SS14.Launcher.Localization"
        xmlns:views="clr-namespace:SS14.Launcher.Views"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="620"
        Width="680" Height="620"
        CanResize="True"
        x:Class="SS14.Launcher.Views.ReplayDetailsDialog"
        x:DataType="vm:ReplayDetailsViewModel"
        Icon="/Assets/icon.ico"
        Title="{loc:Loc replay-dialog-title}"
        Padding="16"
        Background="{DynamicResource ThemePopupBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
  <Design.DataContext>
    <vm:ReplayDetailsViewModel />
  </Design.DataContext>

  <DockPanel LastChildFill="True">
    <!-- BOTTOM ACTIONS -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0, 12, 0, 0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="0">
        <Button Classes="OpenRight" Click="PlayClicked" Content="{loc:Loc replay-dialog-play}" />
        <Button Classes="OpenBoth FavoriteButton" Classes.IsFavorite="{Binding IsFavorite}" Click="ToggleFavoriteClicked"
                ToolTip.Tip="{loc:Loc replay-dialog-favorite}" Padding="6, 4">
          <views:IconLabel Height="18" Width="18" />
        </Button>
        <Button Classes="OpenBoth" Click="ShareClicked" Content="{loc:Loc replay-dialog-share}" />
        <Button Classes="OpenBoth" Click="ExportClicked" Content="{loc:Loc replay-dialog-export}" />
        <Button Classes="OpenLeft" Click="OpenFolderClicked" Content="{loc:Loc replay-dialog-open-folder}" />
      </StackPanel>

      <Button DockPanel.Dock="Right" Click="CloseClicked" Content="{loc:Loc replay-dialog-close}" Margin="6, 0, 0, 0" />
      <TextBlock DockPanel.Dock="Right" Text="{Binding CopyFeedback}" VerticalAlignment="Center"
                 Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" FontSize="12" Margin="0, 0, 8, 0" />
    </DockPanel>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <!-- ROUND OVERVIEW CARD -->
        <Border Classes="Card" Padding="14">
          <StackPanel Spacing="6">
            <DockPanel LastChildFill="True">
              <Border IsVisible="{Binding IsFavorite}" DockPanel.Dock="Right"
                      Background="{DynamicResource ThemeNanoGoldBrush}" CornerRadius="3" Padding="6, 2" Margin="6, 0, 0, 0">
                <TextBlock Text="FAVORITE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ThemeBackgroundColor}" />
              </Border>
              <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="16" Foreground="{DynamicResource ThemeNanoGoldBrush}" />
            </DockPanel>

            <Grid ColumnDefinitions="140, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto" Margin="0, 4, 0, 0">
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc replay-dialog-server}" Classes="SubText" />
              <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServerName}" FontWeight="SemiBold" TextWrapping="Wrap" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc replay-dialog-map}" Classes="SubText" Margin="0, 3, 0, 0" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MapName}" Margin="0, 3, 0, 0" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc replay-dialog-gamemode}" Classes="SubText" Margin="0, 3, 0, 0" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Gamemode}" Margin="0, 3, 0, 0" />

              <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc replay-dialog-round-id}" Classes="SubText" Margin="0, 3, 0, 0" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RoundId}" Margin="0, 3, 0, 0" />

              <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc replay-dialog-duration}" Classes="SubText" Margin="0, 3, 0, 0" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Duration}" Margin="0, 3, 0, 0" />

              <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc replay-dialog-date}" Classes="SubText" Margin="0, 3, 0, 0" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding DateFormatted}" Margin="0, 3, 0, 0" />

              <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc replay-dialog-size}" Classes="SubText" Margin="0, 3, 0, 0" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FileSizeFormatted}" Margin="0, 3, 0, 0" />

              <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc replay-dialog-uncompressed}" Classes="SubText" Margin="0, 3, 0, 0" />
              <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0, 3, 0, 0">
                <TextBlock Text="{Binding UncompressedSizeFormatted}" />
                <Border Background="{DynamicResource ThemeControlMidBrush}" CornerRadius="3" Padding="4, 1"
                        IsVisible="{Binding CompressionRatioFormatted, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding CompressionRatioFormatted, StringFormat='Saved {0}'}" FontSize="10" Foreground="{DynamicResource ThemeForegroundColor}" />
                </Border>
              </StackPanel>

              <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc replay-dialog-sha256}" Classes="SubText" Margin="0, 3, 0, 0" VerticalAlignment="Center" />
              <DockPanel Grid.Row="8" Grid.Column="1" Margin="0, 3, 0, 0" LastChildFill="True">
                <Button DockPanel.Dock="Right" Click="CopyHashClicked" Content="{loc:Loc replay-dialog-copy-hash}" Padding="6, 2" Margin="6, 0, 0, 0" />
                <TextBlock Text="{Binding Sha256}" FontFamily="Consolas, Monospace, Courier New" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- USER NOTE CARD -->
        <Border Classes="Card" Padding="12">
          <StackPanel Spacing="6">
            <DockPanel LastChildFill="False">
              <TextBlock DockPanel.Dock="Left" Text="{loc:Loc replay-dialog-note-header}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
              <Button DockPanel.Dock="Right" Click="SaveNoteClicked" Content="{loc:Loc replay-dialog-note-save}" Padding="10, 3" />
              <TextBlock DockPanel.Dock="Right" Text="{Binding NoteFeedback}" VerticalAlignment="Center"
                         Foreground="{DynamicResource ThemeNanoGoldBrush}" Margin="0, 0, 8, 0" FontSize="11" />
            </DockPanel>
            <TextBox Text="{Binding Note}" Watermark="{loc:Loc replay-dialog-note-watermark}"
                     AcceptsReturn="True" Height="50" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- ARCHIVE CONTENTS LIST -->
        <Border Classes="Card" Padding="12" MinHeight="140" MaxHeight="180">
          <StackPanel Spacing="6">
            <TextBlock Text="{loc:Loc replay-dialog-files-header}" Classes="SectionTitle" FontSize="13" />
            <ListBox ItemsSource="{Binding FileEntries}" Height="110">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}" FontFamily="Consolas, Monospace, Courier New" FontSize="11" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
