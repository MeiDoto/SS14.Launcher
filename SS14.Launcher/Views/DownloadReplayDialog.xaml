<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SS14.Launcher.ViewModels"
        xmlns:loc="clr-namespace:SS14.Launcher.Localization"
        mc:Ignorable="d" d:DesignWidth="540" d:DesignHeight="380"
        Width="540"
        SizeToContent="Height"
        CanResize="False"
        x:Class="SS14.Launcher.Views.DownloadReplayDialog"
        x:DataType="vm:DownloadReplayViewModel"
        Icon="/Assets/icon.ico"
        Title="{loc:Loc replay-download-dialog-title}"
        Padding="16"
        Background="{DynamicResource ThemePopupBackgroundBrush}"
        WindowStartupLocation="CenterOwner">

  <DockPanel LastChildFill="True">
    <!-- BOTTOM ACTIONS -->
    <DockPanel DockPanel.Dock="Bottom" Margin="0, 14, 0, 0" LastChildFill="False">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0" IsVisible="{Binding !IsDownloading}">
        <Button Classes="OpenRight" Click="PlayClicked" Content="{loc:Loc replay-download-play-now}"
                IsVisible="{Binding IsSuccess}" IsDefault="True"
                Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
        <Button Classes="OpenRight" Click="StartDownloadClicked" Content="{loc:Loc replay-download-start-button}"
                IsEnabled="{Binding CanDownload}" IsVisible="{Binding !IsSuccess}" IsDefault="True"
                Foreground="{DynamicResource ThemeNanoGoldBrush}" FontWeight="SemiBold" />
        <Button Classes="OpenLeft" Click="CloseClicked" Content="{loc:Loc replay-download-close}" IsCancel="True" />
      </StackPanel>

      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="0" IsVisible="{Binding IsDownloading}">
        <Button Classes="OpenRight" Click="CancelDownloadClicked" Content="{loc:Loc replay-download-cancel-button}" />
        <Button Classes="OpenLeft" Click="CloseClicked" Content="{loc:Loc replay-download-close}" IsCancel="True" />
      </StackPanel>
    </DockPanel>

    <!-- BODY -->
    <StackPanel Spacing="12">
      <!-- HEADER -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="4">
          <TextBlock Text="{loc:Loc replay-download-dialog-title}" Classes="NanoHeadingMedium" />
          <TextBlock Text="{loc:Loc replay-download-dialog-desc}" Classes="SubText" TextWrapping="Wrap" Margin="0, 4, 0, 0" />
        </StackPanel>
      </Border>

      <!-- SOURCE SELECTION CARD -->
      <Border Classes="Card" Padding="14" IsEnabled="{Binding CanChangeInputs}">
        <StackPanel Spacing="10">
          <!-- Mode Selector -->
          <StackPanel Orientation="Horizontal" Spacing="20">
            <RadioButton Content="{loc:Loc replay-download-mode-url}" IsChecked="{Binding IsByUrl, Mode=TwoWay}" />
            <RadioButton Content="{loc:Loc replay-download-mode-round-id}" IsChecked="{Binding IsByRoundId, Mode=TwoWay}" />
          </StackPanel>

          <!-- MODE 1: Direct URL -->
          <StackPanel Spacing="4" IsVisible="{Binding IsByUrl}">
            <TextBlock Text="{loc:Loc replay-download-url-label}" Classes="SubText" FontSize="11" />
            <Grid ColumnDefinitions="*, Auto">
              <TextBox Grid.Column="0" Text="{Binding UrlInput}" Watermark="{loc:Loc replay-download-url-watermark}"
                       VerticalAlignment="Center" Margin="0, 0, 4, 0" />
              <Button Grid.Column="1" Click="PasteClicked" Content="📋" ToolTip.Tip="{loc:Loc dialog-paste-tooltip}"
                      VerticalAlignment="Center" />
            </Grid>
          </StackPanel>

          <!-- MODE 2: Round ID + Custom Template -->
          <StackPanel Spacing="6" IsVisible="{Binding IsByRoundId}">
            <TextBlock Text="{loc:Loc replay-download-round-id-label}" Classes="SubText" FontSize="11" />
            <Grid ColumnDefinitions="*, Auto">
              <TextBox Grid.Column="0" Text="{Binding RoundIdInput}" Watermark="{loc:Loc replay-download-round-id-watermark}"
                       VerticalAlignment="Center" Margin="0, 0, 4, 0" />
              <Button Grid.Column="1" Click="PasteClicked" Content="📋" ToolTip.Tip="{loc:Loc dialog-paste-tooltip}"
                      VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="{loc:Loc replay-download-custom-template-label}" Classes="SubText" FontSize="11" Margin="0, 4, 0, 0" />
            <TextBox Text="{Binding CustomTemplateInput}" Watermark="https://my-server.com/replays/round_{roundId}.zip" />
            <TextBlock Text="{loc:Loc replay-download-custom-template-hint}" Classes="SubText" FontSize="10" Margin="0, 2, 0, 0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- PROGRESS & STATUS CARD -->
      <Border Classes="Card" Padding="14">
        <StackPanel Spacing="6">
          <DockPanel LastChildFill="True">
            <TextBlock DockPanel.Dock="Right" Text="{Binding DownloadProgressText}" Classes="SubText"
                       FontSize="11" VerticalAlignment="Center" FontWeight="SemiBold" Margin="8, 0, 0, 0" />
            <TextBlock Text="{Binding StatusMessage}" Foreground="{Binding StatusBrush}"
                       Classes="SubText" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" Height="10"
                       IsIndeterminate="{Binding IsIndeterminate}"
                       Margin="0, 4, 0, 0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </DockPanel>
</Window>
